[Unit]
Description=EduNotify WhatsApp Bot
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/moodle/local/edunotify/bot
Environment="EDUNOTIFY_API_KEY=__API_KEY__"
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/html/moodle/local/edunotify/bot/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edunotify-bot

[Install]
WantedBy=multi-user.target
